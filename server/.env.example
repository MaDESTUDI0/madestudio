# Copy this file to .env and fill in real values before running the server.

PORT=4000
NODE_ENV=development

# Postgres connection string. Required — the server refuses to start
# without it. On Render, attach a free Postgres database to this
# service and it'll give you one (use the "External Database URL" if
# connecting from outside Render, e.g. for local dev against the same DB).
# Local example: postgres://user:password@localhost:5432/made_studio
DATABASE_URL=

# Set to "disable" only for a local Postgres with no TLS. Managed
# providers (Render, etc.) need SSL, which is the default.
PGSSL=

# Long random string used to sign session cookies. Required — the server
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of origins allowed to call the API with credentials,
# e.g. https://madestudi0.github.io
ALLOWED_ORIGIN=http://localhost:4000

# Used once by `npm run create-owner` to create the first admin account.
# If OWNER_PASSWORD is left empty, a random one is generated and printed
# to the console — copy it immediately, it is never shown again.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# SMTP credentials used to send the email verification code during
# self-service registration (register.html). Any SMTP provider works —
# e.g. a Gmail account with an "app password", or a transactional
# service like Brevo, Mailgun, Resend (via their SMTP endpoint).
# If left empty, the server does NOT fail — it just prints the
# verification code to the console instead, so registration is still
# testable locally without real email credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MaDE Studio <no-reply@example.com>
